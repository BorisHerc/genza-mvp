# Required — copy to .env locally and set the same values in Vercel → Project → Settings → Environment Variables
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Notifications use Supabase Realtime when public.notifications is in supabase_realtime (migration 004).
# Polling fallback runs automatically if Realtime is unavailable.

# Web push (PWA) — generate VAPID keys: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Deploy: supabase functions deploy send-push-notification
# Set Edge Function secrets: VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY

# Optional: transactional email via server webhook (e.g. Supabase Edge Function + Resend)
# VITE_EMAIL_WEBHOOK_URL=https://your-project.supabase.co/functions/v1/send-email
