# Required — copy to .env locally and set the same values in Vercel → Project → Settings → Environment Variables
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: enable Realtime postgres_changes for notifications (requires supabase_realtime publication)
# VITE_ENABLE_NOTIFICATIONS_REALTIME=true

# Optional: transactional email via server webhook (e.g. Supabase Edge Function + Resend)
# VITE_EMAIL_WEBHOOK_URL=https://your-project.supabase.co/functions/v1/send-email
